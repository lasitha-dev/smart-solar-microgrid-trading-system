# ===================================================================
# SMART SOLAR MICROGRID TRADING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Module: SE4040 Enterprise Application Development (2026)
# Instructions: Copy this file to '.env' and fill in your actual credentials.
# NOTE: Do NOT commit '.env' containing real secrets to version control.
# ===================================================================

# -------------------------------------------------------------------
# 1. MongoDB Database Cluster Configuration
# -------------------------------------------------------------------
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/SmartSolarMicrogridDb?appName=Cluster0
MONGODB_DATABASE_NAME=SmartSolarMicrogridDb
MONGODB_USERS_COLLECTION=User's Detail

# -------------------------------------------------------------------
# 2. JWT Authentication & Token Security Settings
# -------------------------------------------------------------------
JWT_SECRET_KEY=YourSuperSecretKeyWithAtLeast32BytesForHmacSha256SecuritySignature!
JWT_ISSUER=SmartSolarMicrogridApi
JWT_AUDIENCE=SmartSolarMicrogridClients
JWT_EXPIRY_MINUTES=1440

# -------------------------------------------------------------------
# 3. SMTP Email Service & Gmail App Password Credentials
# -------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
ENABLE_SSL=true
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
SENDER_NAME=Smart Solar Microgrid Trading System
PORTAL_URL=http://localhost:5173

# -------------------------------------------------------------------
# 4. QR Signature & Microgrid Security Settings (Member 4)
# -------------------------------------------------------------------
QR_HMAC_SECRET=SSMTS_Enterprise_Solar_Microgrid_2026_HMAC_Secret_Key_Secure_Auth!
QR_PAYLOAD_PREFIX=SSMTS-QR
QR_TOLERANCE_MINUTES=30
