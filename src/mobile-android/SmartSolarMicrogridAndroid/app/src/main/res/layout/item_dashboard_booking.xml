<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/slate_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="4dp"
    app:strokeColor="@color/slate_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header Row: Station Name and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFeedStationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subhead"
                android:textStyle="bold"
                tools:text="Colombo Central Microgrid Hub" />

            <com.sliit.ssmts.operator_dashboard.ui.common.StatusBadgeView
                android:id="@+id/badgeFeedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm" />
        </LinearLayout>

        <!-- Secondary Row: Prosumer NIC & Allocated Bay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFeedProsumerNic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                tools:text="NIC: 199823401234" />

            <TextView
                android:id="@+id/tvFeedBay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/solar_amber_primary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="Bay: BAY-03" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_sm"
            android:background="@color/slate_stroke" />

        <!-- Footer Row: Scheduled Time and Power Allocation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFeedScheduledTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                tools:text="Scheduled: 10:30 AM" />

            <TextView
                android:id="@+id/tvFeedEnergy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/emerald_accent"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="35.00 kWh" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
