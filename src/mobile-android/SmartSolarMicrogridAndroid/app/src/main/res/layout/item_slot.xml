<?xml version="1.0" encoding="utf-8"?>
<!--
  Student: Kumarasinghe S.S | IT22221414
  Layout: Single time-slot card for RecyclerView in SlotSelectionActivity
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ssmts.Card.Metric"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Time Range (e.g. 08:00 - 09:00) -->
        <TextView
            android:id="@+id/tvTimeRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/chipAvailability"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Station + Bay -->
        <TextView
            android:id="@+id/tvStationBay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintEnd_toStartOf="@+id/chipAvailability"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTimeRange" />

        <!-- Availability Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_available"
            android:textColor="@color/status_approved_text"
            app:chipBackgroundColor="@color/status_approved_container"
            app:chipCornerRadius="@dimen/radius_pill"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
