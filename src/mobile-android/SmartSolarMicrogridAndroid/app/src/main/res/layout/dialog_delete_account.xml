<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/slate_surface"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <!-- Warning Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_delete_account_title"
        android:textColor="@color/error_red"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold" />

    <!-- Irreversible Warning Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_md"
        android:lineSpacingExtra="3dp"
        android:text="@string/dialog_delete_account_desc"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_xs" />

    <!-- Registered Email Card / Callout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_input_bg"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registered Account Email:"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_xs" />

        <TextView
            android:id="@+id/tvDeleteTargetEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="user@example.com"
            android:textColor="@color/solar_amber_primary"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:text="@string/dialog_delete_account_prompt"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_xs" />

    <!-- Email Confirmation Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDeleteConfirmEmail"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:hint="@string/hint_confirm_email"
        app:errorEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDeleteConfirmEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Email Match Status Feedback -->
    <TextView
        android:id="@+id/tvDeleteMatchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/error_email_mismatch"
        android:textColor="@color/error_red"
        android:textSize="@dimen/text_xs" />

</LinearLayout>
