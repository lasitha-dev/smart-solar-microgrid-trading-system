<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/surface_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header Row: Station Name, Reference ID, and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHistoryStationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subhead"
                    android:textStyle="bold"
                    tools:text="Colombo Central Microgrid Hub" />

                <TextView
                    android:id="@+id/tvHistoryRefId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_micro"
                    tools:text="Ref: #65f1a2b3c4d5e6f7a8b9c0d1" />
            </LinearLayout>

            <com.sliit.ssmts.operator_dashboard.ui.common.StatusBadgeView
                android:id="@+id/badgeHistoryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm" />
        </LinearLayout>

        <!-- Secondary Row: Prosumer NIC and Allocated Bay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryProsumerNic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                tools:text="Prosumer NIC: 199412345678" />

            <TextView
                android:id="@+id/tvHistoryBay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_secondary_variant"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="Bay: BAY-03" />
        </LinearLayout>

        <!-- Schedule Row: Scheduled Date and Slot Time -->
        <TextView
            android:id="@+id/tvHistoryScheduledTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            tools:text="Scheduled: Sep 17, 2026 10:30 AM" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_sm"
            android:background="@color/surface_card_stroke" />

        <!-- Energy Transfer Metrics Row (FR-M4-03.5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryEstimatedKwh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="Estimated: 35.00 kWh" />

            <!-- Metered Energy (Populated upon finalization) -->
            <LinearLayout
                android:id="@+id/layoutMeteredKwh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_completed"
                android:paddingHorizontal="@dimen/badge_padding_horizontal"
                android:paddingVertical="@dimen/badge_padding_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvHistoryMeteredKwh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/status_completed_text"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    tools:text="Metered: 34.80 kWh" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
