<?xml version="1.0" encoding="utf-8"?>
<!--
  Description: Transfer Completed Receipt layout displaying finalized energy transaction details,
  metered kWh badge, operator signature confirmation, and local cache sync status (FR-M4-07.4).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTransferReceipt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <!-- Header Drag Handle for BottomSheet presentation -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@color/text_hint" />

    <!-- Animated Success Checkmark Container -->
    <FrameLayout
        android:id="@+id/layoutReceiptIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_status_completed">

        <ImageView
            android:id="@+id/ivReceiptSuccessIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@string/receipt_title"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="@color/status_completed_text" />
    </FrameLayout>

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/tvReceiptTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/receipt_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvReceiptSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/receipt_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_caption" />

    <!-- Receipt Details Card -->
    <LinearLayout
        android:id="@+id/cardReceiptDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="@color/surface_background"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Highlighted Delivered kWh Display -->
        <TextView
            android:id="@+id/tvReceiptDeliveredLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/receipt_delivered_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />

        <TextView
            android:id="@+id/tvReceiptDeliveredKwh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/color_secondary"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold"
            tools:text="Delivered: 24.65 kWh" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_md"
            android:background="@color/surface_divider" />

        <!-- Reference & Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReceiptReservationId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                tools:text="Ref: #664fa10b9c3e2e1a4f001201" />

            <com.sliit.ssmts.operator_dashboard.ui.common.StatusBadgeView
                android:id="@+id/badgeReceiptStatus"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/status_badge_height"
                app:badgeStatus="completed" />
        </LinearLayout>

        <!-- Operator Attribution -->
        <TextView
            android:id="@+id/tvReceiptOperator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            tools:text="Operator: OP-PERADENIYA-01" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvReceiptTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            tools:text="Time: 2026-09-18T11:45:00Z" />

        <!-- Local Cache Synchronized Confirmation Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@color/status_completed_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/receipt_cache_synced"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="@color/status_completed_text" />

            <TextView
                android:id="@+id/tvReceiptCacheSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="@string/receipt_cache_synced"
                android:textColor="@color/status_completed_text"
                android:textSize="@dimen/text_size_micro"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Done Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDoneReceipt"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_lg"
        android:backgroundTint="@color/color_primary"
        android:text="@string/btn_done"
        android:textColor="@color/color_on_primary"
        android:textSize="@dimen/text_size_subhead"
        android:textStyle="bold"
        app:cornerRadius="@dimen/radius_sm" />

</LinearLayout>
