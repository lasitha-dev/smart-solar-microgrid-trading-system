<resources>
    <!-- ==========================================
         Member 4: Operator Dashboard Theme (Day/Night Light Surface)
         ========================================== -->
    <style name="Theme.Ssmts.OperatorDashboard" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>

        <!-- Secondary & Tertiary Colors -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary_container</item>
        <item name="colorTertiary">@color/color_tertiary</item>
        <item name="colorOnTertiary">@color/color_on_tertiary</item>

        <!-- System Windows & Backgrounds -->
        <item name="android:statusBarColor">@color/color_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
    </style>

    <!-- Operational Dashboard Metric Card Style -->
    <style name="Widget.Ssmts.Card.Metric" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
    </style>

    <!-- Active Booking Spotlight Card Style -->
    <style name="Widget.Ssmts.Card.Spotlight" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_spotlight</item>
        <item name="cardElevation">@dimen/elevation_spotlight</item>
    </style>

    <!-- Filter Chips Style (FR-M4-03.3) -->
    <style name="Widget.Ssmts.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <!-- Primary Action Button Style -->
    <style name="Widget.Ssmts.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_card</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
    </style>

    <!-- Outlined Secondary Button Style -->
    <style name="Widget.Ssmts.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_card</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="strokeColor">@color/color_primary</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <!-- ==========================================
         Member 1: Prosumer & Auth Theme (Dark-Mode Modern Solar)
         ========================================== -->
    <style name="Theme.SmartSolarMicrogridAndroid" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/solar_amber_primary</item>
        <item name="colorPrimaryDark">@color/solar_amber_dark</item>
        <item name="colorSecondary">@color/emerald_accent</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/slate_bg_dark</item>
        <item name="colorSurface">@color/slate_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_red</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/slate_bg_dark</item>
        <item name="android:navigationBarColor">@color/slate_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Component Defaults -->
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <!-- Custom Text Input Layout Style -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/slate_input_bg</item>
        <item name="boxStrokeColor">@color/slate_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/solar_amber_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!-- Custom Solar Button Style -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/solar_amber_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- Outlined Danger Button -->
    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/error_red</item>
        <item name="android:textColor">@color/error_red</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>
</resources>
