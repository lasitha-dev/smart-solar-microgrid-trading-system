<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Attributes for StatusBadgeView component -->
    <declare-styleable name="StatusBadgeView">
        <attr name="badgeStatus" format="enum">
            <enum name="pending" value="0" />
            <enum name="approved" value="1" />
            <enum name="completed" value="2" />
            <enum name="cancelled" value="3" />
        </attr>
    </declare-styleable>
</resources>
