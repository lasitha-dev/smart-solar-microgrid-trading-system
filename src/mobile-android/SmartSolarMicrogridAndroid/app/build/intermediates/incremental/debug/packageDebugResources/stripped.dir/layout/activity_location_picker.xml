<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_bg_dark">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:id="@+id/llHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLocationPickerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_location_picker"
                android:textColor="@color/solar_amber_primary"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLocationPickerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_location_picker"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>
    </LinearLayout>

    <!-- Interactive Leaflet Map WebView -->
    <WebView
        android:id="@+id/wvMapPicker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeaderBar" />

    <!-- Real-Time Floating Coordinates HUD Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCoordinatesHud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_md"
        app:cardBackgroundColor="@color/slate_surface"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeaderBar"
        app:strokeColor="@color/slate_stroke"
        app:strokeWidth="@dimen/stroke_thin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/section_facility_location"
                    android:src="@drawable/ic_location_pin" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="SELECTED FACILITY COORDINATES"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE MAP"
                    android:textColor="@color/emerald_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCoordinatesLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/solar_amber_primary"
                android:textSize="@dimen/text_base"
                android:textStyle="bold"
                tools:text="Lat: 6.92710°  Lon: 79.86120°" />

            <TextView
                android:id="@+id/tvCoordinatesRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/msg_tap_to_place_hint"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action Button: Microgrid Clusters Selector -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabClusters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        android:backgroundTint="@color/slate_surface"
        android:text="@string/btn_clusters_quick_select"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_xs"
        app:icon="@drawable/ic_grid_view"
        app:iconTint="@color/solar_amber_primary"
        app:layout_constraintBottom_toTopOf="@id/cardBottomActions"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/slate_stroke"
        app:strokeWidth="@dimen/stroke_thin" />

    <!-- Floating Action Button: Find Me (GPS) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFindMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        android:backgroundTint="@color/slate_surface"
        android:contentDescription="@string/btn_find_me"
        android:src="@drawable/ic_gps_fixed"
        app:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/cardBottomActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="24dp"
        app:strokeColor="@color/slate_stroke"
        app:strokeWidth="@dimen/stroke_thin"
        app:tint="@color/emerald_accent" />

    <!-- Bottom Action Card with Confirm Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/slate_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/slate_stroke"
        app:strokeWidth="@dimen/stroke_thin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmLocation"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_confirm_location"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/text_on_primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
